# plumed_reweight.dat — OPES reweighting to the 2D FES (runbook §7.6), via plumed driver
#   plumed driver --noatoms --plumed plumed_reweight.dat --kt 2.577483   (kT at 310 K, kJ/mol)
# NOTE vs runbook template: the reweighting bias is the TOTAL bias (OPES + both walls),
# not opes.bias alone. Inside the walls the wall terms are ~0, but samples that touch a
# wall carry that bias too and must be reweighted by it.
d_tm36:     READ FILE=@COLVAR@ VALUES=d_tm36     IGNORE_TIME IGNORE_FORCES
rmsd_npxxy: READ FILE=@COLVAR@ VALUES=rmsd_npxxy IGNORE_TIME IGNORE_FORCES
b_opes:     READ FILE=@COLVAR@ VALUES=opes.bias  IGNORE_TIME IGNORE_FORCES
b_uw:       READ FILE=@COLVAR@ VALUES=uw.bias    IGNORE_TIME IGNORE_FORCES
b_lw:       READ FILE=@COLVAR@ VALUES=lw.bias    IGNORE_TIME IGNORE_FORCES
bias:       COMBINE ARG=b_opes,b_uw,b_lw PERIODIC=NO

w: REWEIGHT_BIAS ARG=bias TEMP=310

hh: HISTOGRAM ARG=d_tm36,rmsd_npxxy GRID_MIN=@GMIN@ GRID_MAX=@GMAX@ GRID_BIN=100,100 BANDWIDTH=@BW@ LOGWEIGHTS=w
ff: CONVERT_TO_FES GRID=hh TEMP=310
DUMPGRID GRID=ff FILE=@FES_OUT@
