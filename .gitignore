# trajectories and checkpoints
*.xtc
*.trr
*.cpt
*.edr
*.tpr
*.log
!examples/**/expected*.log

# raw downloads (regenerate with structures/fetch.sh)
structures/raw/

# PLUMED state and kernels (can reach GB; keep only if small)
KERNELS*
STATE*

# large COLVAR files — keep a strided copy in results/ instead
COLVAR
COLVAR_*

# environment / local builds (rebuild with env/build_*.sh)
__pycache__/
*.pyc
.venv/
opt/
vendor/
logs/
scratch_*/
\#*\#

# the runbook lives with the lab, not in the repo
instructions.md
structures/clean/*/receptor*
structures/clean/*/pdb2pqr.log
structures/clean.out
systems/*/*.pdb
!systems/*/system_ref.pdb
systems/*/packmol*
systems/*/*.json
!systems/*/build_report.json
systems/*/system.gro
systems/*/system.parm7
systems/*/system.rst7
systems/*/*.gro
systems/*/#*
