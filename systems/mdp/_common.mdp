; shared by every stage; stage files append their own settings (systems/equilibrate.sh)
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
vdwtype                 = cutoff
vdw-modifier            = potential-shift-verlet
rvdw                    = 1.0
DispCorr                = EnerPres
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 6     ; 4 fs + HMR: order 4 / iter 1 lets Met CE methyls spin (LINCS aborts); see NOTES
lincs-iter              = 2
